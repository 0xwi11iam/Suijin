# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets — never bake into images (compose mounts config.json at runtime)
suijin/.env
suijin/config.json
access_keys.json
suijin/operation_state_recovery.json
suijin/engagement_schema.json

# Knowledge base — built on demand inside the container via `suijin pull kb`
# (v4.1: lives in the workspace volume, so a built KB SURVIVES container recreation)
suijin_agent/caches/

# Large third-party (not needed in container)
redamon/

# Agent workspace (mounted as volume)
suijin/suijin_agent/
suijin_agent/

# Notes
suijin/.notes/

# Rust build artifacts (native/suijin-core/target can be GBs)
native/**/target/

# Frontend toolchain
suijin/modules/console/webui/node_modules/
suijin/modules/console/webui/*.tsbuildinfo

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Tests
suijin/tests/
.opencode/
