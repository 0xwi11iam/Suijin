{
  "name": "Snmpenum",
  "version": "1.0",
  "description": "SNMP walk via snmpwalk (v2c public first).",
  "tools": {
    "snmp_walk": {
      "description": "snmpwalk a host/community.",
      "parameters": {
        "host": "Target",
        "community": "Community string (default public)",
        "oid": "OID (default full tree)"
      }
    }
  },
  "dependencies": [
    "snmpwalk"
  ]
}