# Suijin environment — copy to .env and fill in what you have.
# Used by docker compose (docker.sh run) — keys are optional per provider;
# the agent uses whichever provider has a key.
#
#   cp .env.example .env    then edit, then ./docker.sh run

# ── LLM providers (at least one recommended) ──────────────────────────
DEEPSEEK_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── recon / intel APIs (optional) ─────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_SECRET=
VT_API_KEY=
NVD_API_KEY=

# ── misc (optional) ───────────────────────────────────────────────────
HF_TOKEN=
SUIJIN_DOCKER=1

# ── local LLM host overrides (optional) ───────────────────────────────
# In Docker, localhost points at the container, not the host. Set the
# host that runs the model. With SUIJIN_DOCKER=1, localhost providers
# use host.docker.internal by default.
# OLLAMA_HOST=host.docker.internal:11434
# LMSTUDIO_HOST=
# VLLM_HOST=
# LLAMACPP_HOST=
# JAN_HOST=
