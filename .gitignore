# ── Secrets ─────────────────────────────────────────────────────────
.env
*.db
*.sqlite3
opencode.json

# ── Binaries ───────────────────────────────────────────────────────
*.exe
suijin-darwin-*
suijin-linux-*
suijin-windows-*

# ── Temp / build artifacts ─────────────────────────────────────────
.DS_Store
build/
__pycache__/
*.pyc
dist/
# ...except the committed WebUI bundle (suijin ui works without Node)
!suijin/ui/dist/
!suijin/ui/dist/**
*.egg-info/

# ── Runtime agent data (generated, never commit) ───────────────────
suijin_agent/
suijin/suijin_agent/
suijin/knowledge_graph.json
suijin/engagement_schema.json
suijin/operation_state_recovery.json
suijin/blue_config.json
suijin/.notes/
suijin_agent/reports/
suijin_agent/audit_trails/
suijin_agent/outputs/
suijin_agent/sessions/
suijin_agent/credentials.json
suijin_agent/SOUL.md
suijin_agent/scripts/comprehensive_attack.py
suijin_agent/scripts/forge_jwt_and_test.py

# ── Blue Team runtime state (auto-generated) ───────────────────────
suijin_agent/blue_state/
suijin/lab/*/suijin_endpoints.json

# ── Lab databases (auto-generated) ─────────────────────────────────
suijin/lab/*/cloudboard.db
suijin/lab/*/devops.db

# ── Config (has API keys) ──────────────────────────────────────────
config.json

# ── Knowledge base (built on demand via `suijin pull kb`) ──────────
suijin/kb.sqlite3
suijin/kb_cache/

# ── Additional secrets ─────────────────────────────────────────────
access_keys.json
*_state_recovery.json

.coverage
coverage.xml
htmlcov/
.vscode/

# ── WebUI (React sources in webui/; built bundle IS committed at suijin/ui/dist) ──
webui/node_modules/
webui/*.tsbuildinfo
webui/dist/

# ── v2.10 runtime artifacts ───────────────────────────────────────
suijin/cve_cache/
suijin/notify.json
suijin/policy.json
suijin/detector_rules.json
native/suijin-core/target/**/suijin_core.abi3.so

# kernel journal (default-workspace boots in tests write here)
logs/
