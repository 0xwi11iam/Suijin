# ── v5.3 housekeeping ──
# Planning notes are operator-local, never shipped
plan.md
# Session-local provider config (real one is config.json in the package)
suijin/modules/blue_config.json
# Runtime crash logs (belong in the durable workspace, not the repo)
suijin_agent/outputs/logs/
# Red KG store is live engagement state — never shipped (fresh clones start empty)
suijin/modules/redteam/lib/intel/knowledge_graph.json
# Operator-local engagement notes + runtime recovery state
suijin/.notes/
suijin/operation_state_recovery.json

# Malicious scanner fixtures: source is tracked (tests read it), but any
# SEALED builds of them must never be committed
examples/malicious/**/*.sjm
examples/malicious/**/*.sja
examples/malicious/**/*.sjp
examples/malicious/built/

# H-wave runtime artifacts: engagement memory + scratchpad live in the
# workspace (durable home), never in the repo
suijin_agent/outputs/memory/
suijin_agent/outputs/scratchpad/

# Hill CTF runtime state (levers may be edited live; events are engagement data)
suijin/lab/hill_ctf/hill_events.jsonl
suijin/lab/hill_ctf/hill_defense.json
